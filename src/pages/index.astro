---
import Bento from "~/components/bento/Bento.astro";
import BentoCardTitle from "~/components/bento/BentoCardTitle.astro";

import Bluesky from "~/components/icons/bluesky.svg";
import LinkedIn from "~/components/icons/linkedin.svg";
import Email from "~/components/icons/email.svg";
import Twitter from "~/components/icons/twitter.svg";
import Github from "~/components/icons/github.svg";

import BaseLayout from "~/layouts/BaseLayout.astro";
import { SpotlightCard } from "~/components/bento/spotlight-card";
import { SpotlightButton } from "~/components/bento/spotlight-button";
---

<BaseLayout>
	<Fragment slot="head">
		<script>
			import { bentoAnimations } from "~/scripts/animation";

			bentoAnimations();
		</script>
	</Fragment>
	<main>
		<Bento>
			<BentoCardTitle title="Hey, I'm Callum, Welcome." className="large">
				I am a web developer and designer, with experience building high quality user
				experiences in the fintech, gaming, and charity spaces. Have a look around to see some of my work.
			</BentoCardTitle>
			<SpotlightCard
				href="/projects/game-master"
				title="Case Study: Game Master"
				size="tall"
				interactive
				client:load
			>
				I designed and built a web app for writing and organising notes, specifically
				targetting TTRPG players. →
			</SpotlightCard>
			<SpotlightCard title="Explore Projects →" href="/projects" interactive client:load>
				Check out some of the other projects I have worked on.
			</SpotlightCard>
			<SpotlightCard
				title="Case Study: playQ →"
				href="/projects/playq"
				size="wide"
				interactive
				client:load
			>
				I built an app to organise and share lists of videogames. Powered by IGDB.
			</SpotlightCard>
		</Bento>

		<div class="socials">
			<SpotlightButton interactive client:load>
				<div class="item-align">
					<Bluesky />
					<span>
						Bluesky
					</span>
				</div>
			</SpotlightButton>
			<SpotlightButton interactive client:load>
				<div class="item-align">
					<Github />
					<span>
						Github
					</span>
				</div>
			</SpotlightButton>
			<SpotlightButton interactive client:load>
				<div class="item-align">
					<LinkedIn />
					<span>
						LinkedIn
					</span>
				</div>
			</SpotlightButton>
			<SpotlightButton interactive client:load>
				<div class="item-align">
					<Email />
					<span>
						Email
					</span>
				</div>
			</SpotlightButton>
			<SpotlightButton interactive client:load>
				<div class="item-align">
					<Twitter />
					<span>
						Twitter
					</span>
				</div>
			</SpotlightButton>
		</div>

		<Bento>
			<SpotlightCard title="Blog →" href="/blog" interactive size="wide" client:load>
				I sometimes write my thoughts. You can read what I have been thinking about here.
			</SpotlightCard>
			<SpotlightCard title="Case Study: Guinea Pigs →" href="/blog" interactive client:load>
				I built a web app for a local animal charity that focuses on rescuing guinea pigs. Read more!
			</SpotlightCard>
		</Bento>
	</main>
</BaseLayout>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: var(--global-padding);
		margin-bottom: 240px;
	}

	.container {
		padding: 4rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contact-card {
		width: 50vw;
		height: 80vh;
		border-radius: 16px;
		margin: auto;
		background: var(--primary);
	}

	.underline {
		text-decoration: underline;
	}

	.socials {
		width: 100%;
		display: flex;
		justify-content: stretch;
		gap: var(--global-padding);
	}

	.exp-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		min-width: 0;
	}
	.exp-left {
		width: 100%;
		min-width: 0;
		grid-column: span 2;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.exp-right {
		border-left: 2px solid var(--red);
		padding-left: 16px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.item-align {
		display: flex;
		gap: 12px;
		align-items: center;
	}

	@media (max-width: 1024px) {
		p {
			display: none;
		}
	}
</style>
